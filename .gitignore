# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Model checkpoints  (instanovo_v1.1.0.ckpt, SAE checkpoint.pt)
# ---------------------------------------------------------------------------
*.ckpt
*.pt
*.pth

# ---------------------------------------------------------------------------
# Pipeline artefacts -- NEVER commit these.
# Extraction alone is ~67.5M tokens x 768 dims x 4 layers.
# Directory names match run_pipeline.sh: $OUTPUT_ROOT/{extract,annotation,sae}
# ---------------------------------------------------------------------------
outputs/
output/
extract/
annotation/
sae/
chunks/
*.parquet
*.arrow
*.ipc
manifest.json

# Logs and pipeline sentinels
*.log
*.marker
pipeline_stdout.log

# ---------------------------------------------------------------------------
# Secrets / local config
# ---------------------------------------------------------------------------
.env
*.json.key
service-account*.json

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# Research documents and assistant config -- excluded from the anonymous
# submission: these identify the author, institution and supervision context.
# The whole docs/ tree stays local, alongside CLAUDE.md which points into it.
docs/
CLAUDE.md
.claude/

# Reference checkouts kept locally for comparison. Not ours to redistribute,
# and nothing in this repo depends on them.
InstaNovo-internal-*/

# Local log of submitted AIchor experiment ids -- run-specific bookkeeping.
experiment_ids.txt

# Run artefacts pulled back from the AIchor output bucket. Hundreds of MB of
# checkpoints and CSVs per run, reproducible from the bucket, and not source.
results/

# Pipeline artefacts (production and smoke). Individual subdirectories are also
# matched by the extract/ annotation/ sae/ patterns above, but the roots
# themselves otherwise show up as untracked.
sae_pipeline_outputs/
sae_pipeline_outputs_smoke/
